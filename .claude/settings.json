{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash .claude/hooks/pre-commit-test.sh",
            "statusMessage": "커밋 전 테스트 실행 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tdd-reminder.sh",
            "statusMessage": "TDD 규칙 확인 중..."
          }
        ]
      }
    ]
  }
}
